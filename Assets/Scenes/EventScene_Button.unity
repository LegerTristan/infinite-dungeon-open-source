      value: root ::= [a-zA-Z\x0A\x20\x21\x27\x2C\x2D\x2E\x3F]+
      objectReference: {fileID: 0}
    - target: {fileID: 4470054557326383295, guid: b7ab0eb2b92012d48aa228e3efd33729, type: 3}
      propertyPath: _systemPrompt
      value: You are a narrator for a medieval survival story. The player is a prisoner
        escaping the dungeon. Talk in third person. Refer to the player as "you".
        Keep responses under 80 words. Use a descriptive tone.
      objectReference: {fileID: 0}
    - target: {fileID: 5653142259011286119, guid: b7ab0eb2b92012d48aa228e3efd33729, type: 3}
