  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Cold stone clings to your skin as you awaken in the gloom of a dungeon
    cell, every breath tasting of mold, rust, and stale air. \nYour stomach aches
    with a hollow, growing pain, an unmistakable warning that time is already running
    short. \nThe torch beyond the bars flickers weakly, its glow revealing the unmistakable
    signs of a place where prisoners were left to wither away. \nAhead, a single
    loose stone juts from the wall, its edges worn as if others once tried to pry
    it free in desperate pursuit of survival."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 58739fb42aea5fb4f97d131418b25e9a, type: 2}
  m_sharedMaterial: {fileID: 656142522542267028, guid: 58739fb42aea5fb4f97d131418b25e9a, type: 2}
